+            char redir_url[PATH_MAX];
+
+            snprintf(redir_url, sizeof(redir_url), "%s", req->url);
             vf_request_free(req);
             req = NULL;
-            rc = vf_stat(destdir, req->url, vfstat, NULL);
+            rc = vf_stat(redir_url, destdir, vfstat, NULL);
 
         } else {
             vfile_set_errno(mod->vfmod_name, req->req_errno);
